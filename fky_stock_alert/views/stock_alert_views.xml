<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_stock_alert_tree" model="ir.ui.view">
        <field name="name">stock.alert.rule.tree</field>
        <field name="model">stock.alert.rule</field>
        <field name="arch" type="xml">
            <tree editable="bottom"
                  decoration-danger="state == 'low'"
                  decoration-success="state == 'ok'">
                <header>
                    <button name="%(action_stock_alert_generator)d" string="Generate Rules" type="action" class="btn-primary"/>
                </header>
                <field name="is_favorite" widget="boolean_favorite" nolabel="1"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="qty_available" string="On Hand" readonly="1"/>
                <field name="min_qty"/>
                <field name="state"
                       widget="badge"
                       decoration-danger="state == 'low'"
                       decoration-success="state == 'ok'"
                       readonly="1"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_stock_alert_form" model="ir.ui.view">
        <field name="name">stock.alert.rule.form</field>
        <field name="model">stock.alert.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="ok,low"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_favorite" widget="boolean_favorite" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Product">
                            <field name="product_id"/>
                            <field name="location_id"/>
                        </group>
                        <group string="Alert Rule">
                            <field name="min_qty"/>
                            <field name="qty_available" string="Current On Hand"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_stock_alert_search" model="ir.ui.view">
        <field name="name">stock.alert.rule.search</field>
        <field name="model">stock.alert.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="location_id"/>
                <filter string="Favorites"
                        name="favorites"
                        domain="[('is_favorite','=',True)]"/>
                <separator/>
                <filter string="Low Stock"
                        name="low_stock"
                        domain="[('state','=','low')]"/>
                <filter string="OK"
                        name="ok_stock"
                        domain="[('state','=','ok')]"/>
                <group expand="0" string="Group By">
                    <filter string="Location"
                            name="group_location"
                            context="{'group_by':'location_id'}"/>
                    <filter string="Status"
                            name="group_state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_stock_alert" model="ir.actions.act_window">
        <field name="name">Stock Alert Dashboard</field>
        <field name="res_model">stock.alert.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_low_stock': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock alert rules yet!
            </p>
            <p>
                Create alert rules to monitor stock levels at specific locations.
                Only actual on-hand quantity is tracked — no forecasted or incoming.
            </p>
        </field>
    </record>

</odoo>
