<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quantity_history_inherit_warehouse" model="ir.ui.view">
        <field name="name">stock.quantity.history.form.warehouse</field>
        <field name="model">stock.quantity.history</field>
        <field name="inherit_id" ref="stock.view_stock_quantity_history"/>
        <field name="arch" type="xml">
            <field name="inventory_datetime" position="after">
                <field name="warehouse_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
