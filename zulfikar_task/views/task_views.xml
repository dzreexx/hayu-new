    <record id="view_zulfikar_task_tree" model="ir.ui.view">
        <field name="name">zulfikar.task.tree</field>
        <field name="model">zulfikar.task</field>
        <field name="arch" type="xml">
            <tree string="Daftar Tugas" create="0">
                <field name="name"/>
                <field name="date"/>
                <field name="is_done"/>
            </tree>
        </field>
    </record>

    <record id="action_zulfikar_task" model="ir.actions.act_window">
        <field name="name">Tugas Harian</field>
        <field name="res_model">zulfikar.task</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_zulfikar_task_root" 
