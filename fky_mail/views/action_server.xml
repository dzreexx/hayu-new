<odoo>
    <record id="view_fky_mail_form" model="ir.ui.view">
        <field name="name">fky.mail.form</field>
        <field name="model">fky.mail</field>
        <field name="arch" type="xml">
            <form string="Send Merged Invoices">
                <group>
                    <field name="partner_ids" widget="many2many_tags" readonly="1"/>
                    <field name="email_cc"/>
                    <field name="auto_delete"/>
                    <field name="mail_template_id"/>
                    <field name="subject"/>
                    <field name="report_id"/> <!-- Re-added for manual selection if needed -->
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <field name="message_body"/>
                </group>
                <footer>
                    <button string="Send" name="action_send_mass_pdf" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fky_mail" model="ir.actions.act_window">
        <field name="name">Send Merged Invoices</field>
        <field name="res_model">fky.mail</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
